<% content_for :per_page_js do %>
  <%= javascript_include_tag "home_index", "data-turbo-track": 'reload', defer: true %>
<% end %>
<div class="page-shell container" id="homeContainer">

  <% unless user_signed_in? %>
    <%= render 'logged_out_info' %>
  <% end %>

  <% if user_signed_in? %>
    <%= render 'shared/made_this_modal' %>

    <div class="page-header"><h1>Your home bar</h1><%= link_to 'Add a bottle', new_reagent_path, class: 'btn btn-primary' %></div>
    <h2>Your favorite drinks</h2>
    <% if @users_favorite_cocktail_counts.empty? %>
      <div class="empty-state mb-4"><p class="mb-2">Favorite recipes will appear here for quick access.</p><%= link_to 'Browse cocktails', cocktails_path, class: 'btn btn-outline-primary' %></div>
    <% else %>
    <div class="row">
      <div class="col-sm-10 table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 15%">Name</th>
              <th style="width: 10%">Available</th>
              <th style="width: 15%">Show Ingredients</th>
              <th style="width: 60%">Ingredients</th>
            </tr>
          </thead>
          <tbody>
            <% @users_favorite_cocktail_counts.each do |cocktail, count| %>
              <tr data-controller="home-index">
                <td><%= link_to cocktail.name.html_safe, cocktail_path(cocktail) %></td>
                <td><%= count =%></td>
                <td>
                  <%=
                    link_to 'Show Ingredients',
                      cocktail_path(cocktail),
                      class: "btn btn-outline-info",
                      data: {
                        turbo_frame: dom_id(cocktail),
                        action: "click->home-index#toggleCollapse",
                        toggled: 'false'
                      }
                  %>
                </td>
                <td>
                  <div class="collapse" data-home-index-target="collapse">
                    <%= turbo_frame_tag(cocktail) do %>
                      <p>Loading...</p>
                    <% end %>
                    <%= link_to 'Make Drink', drink_making_path(cocktail), class: 'btn btn-primary', data: { turbo_frame: 'madeThisModalFrame' } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>

    <h2 class="mt-4">Ready to make</h2>
    <h3 class="h5 text-muted"><%= pluralize(@users_available.count, 'personal cocktail') %></h3>
    <% if @users_available.empty? %>
      <div class="empty-state mb-4"><p class="mb-2">Add bottles to see which personal recipes you can make.</p><%= link_to 'Add a bottle', new_reagent_path, class: 'btn btn-outline-primary' %></div>
    <% else %>
    <div class="row">
      <div class="col-sm-10 table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 15%">Name</th>
              <th style="width: 20%">Show Ingredients</th>
              <th style="width: 65%">Ingredients</th>
            </tr>
          </thead>
          <tbody>
            <% @users_available.each do |cocktail| %>
              <tr data-controller="home-index">
                <td><%= link_to cocktail.name.html_safe, cocktail_path(cocktail) %></td>
                <td>
                  <%=
                    link_to 'Show Ingredients',
                      cocktail_path(cocktail),
                      class: "btn btn-outline-info", 
                      data: { 
                        turbo_frame: dom_id(cocktail),
                        action: "click->home-index#toggleCollapse",
                        toggled: 'false'
                      }
                  %>
                </td>
                <td>
                  <div class="collapse" data-home-index-target="collapse">
                    <%= turbo_frame_tag(cocktail) do %>
                      <p>Loading...</p>
                    <% end %>
                    <%= link_to 'Make Drink', drink_making_path(cocktail), class: 'btn btn-primary', data: { turbo_frame: 'madeThisModalFrame' } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>

      <h3 class="h5 text-muted mt-4"><%= pluralize(@shared_available.count, 'shared cocktail') %></h3>
      <% if @shared_available.empty? %>
        <div class="empty-state mb-4"><p class="mb-0">Shared recipes you can make will show up here.</p></div>
      <% else %>
      <div class="row">
        <div class="col-sm-10 table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th style="width: 15%">Name</th>
                <th style="width: 20%">Show Ingredients</th>
                <th style="width: 65%">Ingredients</th>
              </tr>
            </thead>
            <tbody>
              <% @shared_available.each do |cocktail| %>
                <tr data-controller="home-index">
                  <td><%= link_to cocktail.name.html_safe, cocktail_path(cocktail) %></td>
                  <td>
                    <%=
                      link_to 'Show Ingredients',
                        cocktail_path(cocktail),
                        class: "btn btn-outline-info", 
                        data: { 
                          turbo_frame: dom_id(cocktail),
                          action: "click->home-index#toggleCollapse",
                          toggled: 'false'
                        }
                    %>
                  </td>
                  <td>
                    <div class="collapse" data-home-index-target="collapse">
                      <%= turbo_frame_tag(cocktail) do %>
                        <p>Loading...</p>
                      <% end %>
                      <%= link_to 'Make Drink', drink_making_path(cocktail), class: 'btn btn-primary', data: { turbo_frame: 'madeThisModalFrame' } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <% end %>
    </div>

    <%= render 'shared/error_toast' %>
    <%= render 'shared/cheers_toast' %>

  <% end %>
</div>
