<% content_for :per_page_js do %>
  <%= javascript_include_tag "cocktail_show", "data-turbo-track": 'reload', defer: true %>
<% end %>
<main class="page-shell">
  <div class="container">
    <%= render 'shared/notice' %>
    <div class="page-header">
      <h1><%= @cocktail.name %></h1>
      <% if user_signed_in? %>
        <%= link_to(@favorite ? 'Remove favorite' : 'Favorite', cocktail_toggle_favorite_path(@cocktail), class: 'btn btn-outline-primary', method: :post) %>
      <% end %>
    </div>
    <div class="row mt-3">
      <div class="col-sm-3">
        <span class="badge badge-shared"><%= @cocktail.shared? ? 'Shared' : 'My recipe' %></span>
        <% if @families.any? %>
          <p class="mt-3"><strong>Families:</strong></p>
          <ul>
            <% @families.each do |family| %>
              <li><%= user_signed_in? ? link_to(family.name, cocktail_family_path(family)) : family.name %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <div class="col">
        <strong>Cocktail Stats:</strong>
        <% if user_signed_in? %>
          <p>You've made this drink <span id="made_count"><%= @stats[:made_count] %></span> times!</p>
        <% end %>
        <% if @cocktail.shared? %>
          <p>All Barkeep users have made this drink <span id="made_globally_count"><%= @stats[:made_globally_count] %></span> times!</p>
        <% end %>
      </div>
      <div class="col">
        <%= render 'shared/user_notes_table', audits: @recent_audits if user_signed_in? %>
        <%= render 'community_notes' if @cocktail.shared? %>
      </div>
    </div>
    <% if @cocktail.parent.present? && (@cocktail.parent.shared? || @cocktail.parent.owned_by?(current_user)) %>
      <p><small>This recipe was originally copied from <%= link_to @cocktail.parent.name, cocktail_path(@cocktail.parent) %>.</small></p>
    <% end %>
    <hr>
    <p><strong>Ingredients:</strong></p>
    <div data-controller="cocktail-scale">
      <div class="row mb-3">
        <div class="col-sm-3">
          <%= label_tag :cocktail_servings, 'Servings', class: 'form-label' %>
          <%= select_tag :cocktail_servings, options_for_select(1..12, 1), class: 'form-select',
                         data: { 'cocktail-scale-target': 'servings', action: 'change->cocktail-scale#scale' } %>
        </div>
      </div>
      <%= turbo_frame_tag(@cocktail) do %>
        <%= render 'shared/full_ingredients_table', cocktail: @cocktail %>
      <% end %>
    </div>
    <%= render 'actions' %>
    <% if user_signed_in? %>
      <%= render 'shared/made_this_modal' %>
      <div class="mt-3">
        <% if @cocktail.user_can_make?(current_user) %>
          <p>You have all the ingredients to make this drink!
          <%= link_to 'Make Drink', drink_making_path(@cocktail), class: 'btn btn-success', data: { turbo_frame: 'madeThisModalFrame' } %></p>
        <% end %>
        <p>You can always make a drink with substitutions:
        <%= link_to 'Make Drink (with a twist)', drink_making_path(@cocktail, twist_mode: true), class: 'btn btn-success', data: { turbo_frame: 'madeThisModalFrame' } %></p>
      </div>
    <% end %>
    <%= render 'shared/reagents_guide' %>
    <%= render 'shared/similar_cocktails', cocktail: @cocktail %>
    <%= render 'shared/error_toast' %>
    <%= render 'shared/cheers_toast' %>
  </div>
</main>
